# Local services
DERMAGUARD_API_URL=http://127.0.0.1:8000
DERMAGUARD_DATABASE_URL=sqlite:///data/dermaguard.db

# Doctor-workstation login. Set a strong local password before first launch.
XINFU_ADMIN_USERNAME=Ljh
XINFU_ADMIN_PASSWORD=
XINFU_ADMIN_NAME=信肤管理员

# Frozen DermFM-Zero provider environment. The checkpoint remains a normal disk file.
# The sibling dermfm-zero Conda environment is detected automatically.
# DERMAGUARD_VISION_PYTHON=/path/to/dermfm-zero/bin/python

# Local medical retrieval: BM25 + IlhaEmbed Dense, fused with RRF.
# Set to 0 for BM25 only; Dense failures are reported as an explicit fallback.
DERMAGUARD_RAG_ADVANCED=1
# DERMAGUARD_RAG_PYTHON=/path/to/dermfm-zero/bin/python
DERMAGUARD_EMBEDDING_PATH=weights/rag/IlhaEmbed
# Native tool-calling evidence Agent reuses the configured chat provider.
# Mock always stays offline, even if a RAG model or credentials are present.
DERMAGUARD_RAG_MODEL=auto
DERMAGUARD_RAG_LLM_TIMEOUT=12
DERMAGUARD_RAG_WORKER_TIMEOUT=20
# Overall evidence budgets live in backend/config.yaml (8 tools / 10 model turns / 45s).

# Chat defaults to Mock and requires no account or API key.
DERMAGUARD_CHAT_PROVIDER=mock

# Optional DeepSeek OpenAI-compatible API. Current official model IDs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# Empty means: concise replies disable thinking; detailed replies enable it.
DEEPSEEK_THINKING=
DEEPSEEK_MAX_TOKENS=1800

# Optional Groq free-tier chat. Never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low 适合网页交互的速度/质量平衡；可改为 medium 或 high。
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=1400

# Optional Zhipu GLM free-tier chat.
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-4.7-flash

# Optional Gemini Flash. The floating chat lists it as unavailable until set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
